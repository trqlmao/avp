{
  "name": "avp-grpc-example",
  "version": "0.0.0",
  "private": true,
  "description": "gRPC reference client and server for AVP, loading the canonical proto/avp.proto dynamically. Illustrative, not production.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "server": "node --import tsx server/main.ts",
    "client": "node --import tsx client/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
