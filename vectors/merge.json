    {
      "name": "tick-follows-wall-clock",
      "note": "tick(now) is (now, 0) when now > at, else (at, n + 1), so a clock that stalls or steps back still issues increasing stamps.",
      "start": {
        "at": 0,
        "n": 0
      },
      "steps": [
        {
          "op": "tick",
          "now": 1000,
          "expect": {
            "at": 1000,
            "n": 0
          }
        },
        {
          "op": "tick",
          "now": 1000,
          "expect": {
            "at": 1000,
            "n": 1
          }
        },
        {
          "op": "tick",
          "now": 999,
          "expect": {
            "at": 1000,
            "n": 2
          }
        },
        {
          "op": "tick",
          "now": 1001,
          "expect": {
            "at": 1001,
            "n": 0
          }
        }
      ]
    },
